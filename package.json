{
  "name": "music-companion",
  "version": "1.0.0",
  "description": "An AI-powered music companion featuring conversational music discovery, personalized recommendations, intelligent playlists and long-term memory.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "server": "node server/server.js",
    "ncm": "node scripts/ncm.js",
    "check": "node --check server/server.js && node --check scripts/start.js",
    "test": "node --test"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "overrides": {
    "NeteaseCloudMusicApi": {
      "pac-proxy-agent": {
        "get-uri": {
          "basic-ftp": "6.2.6"
        }
      },
      "music-metadata": "11.16.1"
    }
  }
}
